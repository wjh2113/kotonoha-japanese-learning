{
  "name": "kotonoha-japanese-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node --env-file-if-exists=.env --watch server.mjs\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "db:local:init": "bash scripts/postgres-local.sh init",
    "db:local:start": "bash scripts/postgres-local.sh start",
    "db:local:status": "bash scripts/postgres-local.sh status",
    "db:local:stop": "bash scripts/postgres-local.sh stop",
    "db:local:init:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 init",
    "db:local:start:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 start",
    "db:local:status:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 status",
    "db:local:stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres-local.ps1 stop",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server.mjs",
    "deploy": "bash scripts/deploy-jdcloud.sh",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "mammoth": "^1.12.2",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^29.1.1",
    "typescript": "latest",
    "vitest": "latest"
  }
}
