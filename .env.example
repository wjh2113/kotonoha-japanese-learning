# 仅服务端读取，不要使用 VITE_ 前缀，也不要提交真实 Key
LLM_GATEWAY_URL=https://aiapimgrapi.aidigitcloud.cn
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TENANT=Japan
LLM_GATEWAY_CHAT_CAPABILITY=quality-chat
LLM_GATEWAY_ENRICH_CAPABILITY=fast-chat
LLM_GATEWAY_SPEECH_CAPABILITY=speech
LLM_GATEWAY_VISION_CAPABILITY=vision
PORT=8787
HOST=0.0.0.0
# 生产环境请设置访问密码；本地留空则不启用登录门
ACCESS_PASSWORD=
POSTGRES_PASSWORD=change-me
# Docker Compose 默认：
DATABASE_URL=postgresql://kotonoha_app:change-me@127.0.0.1:5432/kotonoha
# macOS / Linux 本地隔离实例（npm run db:local:init）可改为：
# DATABASE_URL=postgresql://kotonoha_app@127.0.0.1:5433/kotonoha
